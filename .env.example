# Copier ce fichier en .env.local et le remplir (ne jamais versionner .env.local).

# Domaine définitif du site (balises canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.codisco-gibat.com

# Envoi du formulaire de contact par SMTP authentifié
# (sans ces valeurs, en local, les demandes s'affichent simplement dans le terminal)
SMTP_HOST=mail.codisco-gibat.com
SMTP_PORT=465
SMTP_USER=site@codisco-gibat.com
SMTP_PASS=
CONTACT_TO=contact@codisco-gibat.com
CONTACT_FROM=site@codisco-gibat.com
